; 这是「初始」资料库。prepare、fill 和 sync-profile 会按照 Word 内的
; {{变量名}} 自动追加缺失字段；已有字段和值绝不改写。
; 这是明文文件：不要上传给 AI、不要提交到 Git、不要放进网盘同步目录。
; 更推荐填好后用 vault 命令加密，并在 fill 时使用 --vault。

[profile]
FULL_NAME =
NAME_PINYIN =
ID_NUMBER =
PHONE =
EMAIL =
QQ =
WECHAT =
EMERGENCY_CONTACT_RELATION =
EMERGENCY_PHONE =
FATHER_NAME =
FATHER_PHONE =
MOTHER_NAME =
MOTHER_PHONE =
